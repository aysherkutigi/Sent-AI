# Environment configuration template

# API Configuration
DEBUG=True
API_TITLE=Sentinel Africa AI

# Database
DATABASE_URL=sqlite:///./sentinel.db
# For PostgreSQL: postgresql://user:password@localhost/sentinel
# For MySQL: mysql+pymysql://user:password@localhost/sentinel

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# AI/ML
MODEL_PATH=./models
ENABLE_OFFLINE_MODE=True

# Logging
LOG_LEVEL=INFO
